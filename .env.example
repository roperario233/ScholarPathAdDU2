# Supabase project credentials. These are required: without them the app cannot
# load data or sign in (there is no offline demo mode).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical site URL used as the redirect target for Google sign-in, password
# reset links, and account confirmation emails. Supabase Auth only returns the
# browser to a URL allow-listed under Authentication -> URL Configuration, and
# otherwise silently falls back to the project's Site URL. Set this to the
# deployed origin (for example https://scholarpath-addu.vercel.app/) so preview
# and local builds still return to the live prototype.
VITE_SITE_URL=https://scholarpath-addu.vercel.app/

# Browser-enforced authenticated session limits. Defaults are 15 minutes idle
# and 12 hours absolute, with a 60-second warning before expiry. These values
# are client policy; also configure an appropriate refresh-token lifetime in
# Supabase Authentication -> Sessions for server-side defense in depth.
VITE_SESSION_IDLE_TIMEOUT_MINUTES=15
VITE_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
VITE_SESSION_WARNING_SECONDS=60

# --- Student support inbox / tawk.to fallback -------------------------------
# `inbox` enables the ScholarPath in-app inbox (migration 20261051000000).
# Set `tawk` to show the optional tawk.to live-chat widget instead.
VITE_SUPPORT_CHANNEL=inbox
# tawk.to public IDs, used only when VITE_SUPPORT_CHANNEL=tawk. Copy them from
# Administration -> Channels -> Chat Widget -> Widget Code:
#   https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
# These are public identifiers, not secrets. The same values must be set in
# the deployed hosting environment.
VITE_TAWK_PROPERTY_ID=6ae2c9732afdd33474271165
VITE_TAWK_WIDGET_ID=1k62u5r7a

# --- Edge Function secrets (server-side only) -------------------------------
# These are NOT Vite variables. They must never carry a VITE_ prefix, because
# anything with that prefix is inlined into the browser bundle and would leak
# the Resend key to every visitor. Set them on the Supabase project instead:
#
#   supabase secrets set "RESEND_API_KEY=re_xxx" "RESEND_FROM_EMAIL=alerts@yourdomain" ^
#     "RESEND_FROM_NAME=ScholarPath AdDU" "APP_SITE_URL=https://scholarpath-addu.vercel.app/" ^
#     "REMINDER_CRON_SECRET=<a long random value>"
#
# (or Dashboard -> Project Settings -> Edge Functions -> Secrets)
#
# RESEND_API_KEY     Resend API key used by process-deadline-reminders,
#                    notify-application-status and send-test-email. A
#                    sending_access key is sufficient; full access is not needed.
# RESEND_FROM_EMAIL  Verified sending address, e.g. alerts@scholarpath.site.
#                    The domain must be verified in Resend first.
# RESEND_FROM_NAME   Optional display name, combined as "Name <address>".
# APP_SITE_URL       Optional. Origin used for the link inside emails.
#                    Defaults to VITE_SITE_URL's production origin.
# REMINDER_CRON_SECRET
#                    Shared secret for the scheduled caller. Generate a long
#                    random value; the pg_cron job must send the identical value
#                    (see the scheduling block in supabase/schema.sql). Without
#                    it the scheduled run cannot authenticate.
#
# Emails cannot be delivered from an address on an unverified domain, and the
# Resend shared sender onboarding@resend.dev only reaches the Resend account
# owner's own inbox. Verify the domain before expecting student delivery.
#
# --- Google Calendar and Meet interview secrets (server-side only) -----------
# Used by manage-interview-event and notify-interview-event (SOP step 5). Also
# server-side only: never give these a VITE_ prefix.
#
# Generate the refresh token with the helper, signed in as the account that OWNS
# the interview calendar. The helper reads both client values from this file (or
# from the shell, which wins for that run), so no second copy is needed:
#
#   npm run google:auth
#
# The script prints every calendar the account can write to and the exact
# `supabase secrets set` command.
#
# GOOGLE_OAUTH_CLIENT_ID /
# GOOGLE_OAUTH_CLIENT_SECRET
#                    Web-application OAuth client. Register the redirect URI
#                    http://localhost:5555/oauth2callback for the helper.
#                    Scopes: calendar.events (runtime) plus
#                    calendar.calendarlist.readonly (the helper only).
# GOOGLE_CALENDAR_REFRESH_TOKEN
#                    Consent is bound to one Google account. That account must
#                    own the interview calendar, or the Calendar API answers
#                    404 "Not Found" even though the token itself is valid.
# GOOGLE_CALENDAR_ID Optional. The interview calendar's id
#                    (xxxx@group.calendar.google.com), copied with a literal "@".
#                    Defaults to "primary", which is the organizer's own
#                    calendar — set it so interviews do not mix with personal
#                    events.
#
# While the OAuth consent screen is External + Testing, refresh tokens expire
# after 7 days: re-run `npm run google:auth` and update the secret. Without these
# secrets the integration reports configured:false and online interviews use a
# pasted meeting link plus the .ics download.
